FROM node:26-alpine

# Create a non-root user for the application
RUN addgroup -S app && adduser -S -G app app

# Set the working directory
WORKDIR /app
RUN chown app:app /app

USER app

# Install project dependencies
COPY --chown=app:app package.json package-lock.json .npmrc ./
RUN npm ci

# Copy application files and build the SvelteKit app
COPY --chown=app:app be ./be
COPY --chown=app:app fe ./fe
COPY --chown=app:app shared ./shared
COPY --chown=app:app scripts ./scripts
COPY --chown=app:app vite.config.mjs tsconfig.json ./
RUN npm run build && npm prune --omit=dev

# Run the project
CMD ["node", "be/server/server.js"]
