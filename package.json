{
  "name": "public-transport-in-serbia",
  "version": "1.0.0",
  "description": "",
  "main": "be/server/server.js",
  "scripts": {
    "run": "node be/server/server.js",
    "dev": "concurrently -k \"PORT=3001 node be/server/server.js\" \"vite dev --host 0.0.0.0 --port 3000\"",
    "start": "node be/server/server.js",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "build": "node scripts/gen-theme.mjs && vite build && node scripts/mark-build-esm.mjs",
    "test": "vitest run",
    "lint": "eslint be/server fe/static tests fe/src scripts eslint.config.mjs vite.config.mjs",
    "format:check": "prettier --check \"be/server/**/*.js\" \"fe/static/**/*.{js,html,css}\" \"fe/src/**/*.{js,mjs,ts,svelte,css,html}\" \"tests/**/*.{js,mjs,ts}\" \"scripts/**/*.mjs\" package.json package-lock.json README.md AGENTS.md .github/workflows/ci.yml eslint.config.mjs .prettierrc.json vite.config.mjs tsconfig.json",
    "verify": "npm run check && npm run lint && npm run format:check && npm test && npm run build"
  },
  "author": "",
  "license": "AGPL-3.0",
  "engines": {
    "node": "^26.0.0"
  },
  "imports": {
    "#lib/*": "./fe/src/lib/*",
    "#shared/*": "./shared/*"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.1",
    "@fastify/rate-limit": "^11.2.1",
    "@fastify/static": "^10.1.7",
    "@fontsource-variable/roboto": "^5.3.0",
    "@ktibow/iconset-material-symbols": "^0.0.1764827375",
    "@ktibow/material-color-utilities-nightly": "^0.4.1768930731000",
    "@sveltejs/adapter-node": "^6.0.0",
    "@sveltejs/kit": "^3.1.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "axios": "^1.20.0",
    "crypto-js": "^4.2.0",
    "fastify": "^5.12.7",
    "idb": "^8.0.4",
    "leaflet": "^1.9.4",
    "leaflet.markercluster": "^1.5.3",
    "m3-svelte": "7.2.1",
    "pino-pretty": "^13.2.0",
    "svelte": "^5.57.3",
    "vite": "^8.3.5",
    "vite-plugin-functions-mixins": "^0.4.1",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/leaflet": "^1.9.22",
    "@types/leaflet.markercluster": "^1.5.6",
    "@types/node": "^26.6.5",
    "concurrently": "^10.0.6",
    "eslint": "^10.13.0",
    "eslint-plugin-svelte": "^3.23.1",
    "fake-indexeddb": "^6.2.6",
    "globals": "^17.13.0",
    "jquery": "^4.0.0",
    "jsdom": "^30.1.3",
    "nodemon": "^3.1.14",
    "prettier": "^3.9.10",
    "prettier-plugin-svelte": "^4.1.1",
    "svelte-check": "^4.7.7",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.0.5"
  }
}
